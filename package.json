{
  "name": "@fishonfire/bubbles-expo",
  "version": "0.1.0",
  "description": "Expo config plugin, explicit background registration API, and React provider for Bubbles notifications.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./register-task": {
      "types": "./dist/register-task.d.ts",
      "import": "./dist/register-task.mjs",
      "require": "./dist/register-task.js"
    }
  },
  "files": [
    "dist",
    "plugin/build",
    "app.plugin.js",
    "README.md"
  ],
  "sideEffects": [
    "./src/register-task.ts",
    "./dist/register-task.js",
    "./dist/register-task.mjs"
  ],
  "scripts": {
    "build": "npm run build:runtime && npm run build:plugin",
    "build:runtime": "tsup src/index.ts src/register-task.ts --format cjs,esm --dts --clean",
    "build:plugin": "rm -rf plugin/build && tsc -p plugin/tsconfig.json",
    "clean": "rm -rf dist plugin/build",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "npm run typecheck:runtime && npm run typecheck:plugin && npm run typecheck:test",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "typecheck:runtime": "tsc --noEmit",
    "typecheck:plugin": "tsc -p plugin/tsconfig.json --noEmit"
  },
  "keywords": [
    "bubbles",
    "expo",
    "expo-notifications",
    "config-plugin",
    "react-native",
    "background-task",
    "push-notifications",
    "fcm",
    "apns"
  ],
  "peerDependencies": {
    "@react-native-firebase/app": ">=26.3.3",
    "@react-native-firebase/installations": ">=26.3.3",
    "@react-native-firebase/messaging": ">=26.3.3",
    "expo": ">=57.0.0",
    "expo-notifications": ">=0.28.0",
    "react": ">=19.0.0",
    "react-native": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "dependencies": {
    "@fishonfire/bubbles-js": "file:../bubbles-notifications-js",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.16",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6"
  },
  "devDependencies": {
    "@react-native-firebase/app": "^26.3.3",
    "@react-native-firebase/installations": "^26.3.3",
    "@react-native-firebase/messaging": "^26.3.3",
    "@types/react": "^19.2.18",
    "expo": "~57.0.11",
    "expo-notifications": "~57.0.9",
    "react": "^19.2.8",
    "react-native": "^0.87.1",
    "tsup": "^8.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
